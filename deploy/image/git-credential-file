#!/usr/local/bin/python
"""Read an operator-mounted GitHub token; never store credentials in Git URLs."""
import sys
from pathlib import Path
if sys.argv[1:] == ['get']:
    fields = dict(line.rstrip('\n').split('=', 1) for line in sys.stdin if '=' in line)
    token = Path('/config/github-token')
    if fields.get('protocol') == 'https' and fields.get('host') == 'github.com' and token.is_file():
        print('username=x-access-token')
        print('password=' + token.read_text().strip())
