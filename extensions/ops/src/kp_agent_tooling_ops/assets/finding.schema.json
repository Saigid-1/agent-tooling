{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ops.verification-finding.v5"
    },
    "claim": {
      "type": "object",
      "description": "One falsifiable proposition per artifact. Independent predicates or targets require separate findings; semantics require review.",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target": {
          "enum": [
            "baseline",
            "candidate",
            "deployment"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "subject",
        "target",
        "predicate",
        "expected_value"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "supported",
        "contradicted",
        "unverified"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "execution_evidence": {
          "description": "Identity of compared execution evidence, not identity of the claim subject. Null for source-only findings.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "runtime_service": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "Exact observed service for joint runtime observations; the controlled workload service is not deployment proof."
                },
                "execution_revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "candidate_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "profile",
                "execution_revision",
                "candidate_sha256"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "scenario",
        "sources",
        "execution_evidence"
      ],
      "additionalProperties": false
    },
    "packets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "slice_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "packet_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "slice_id",
          "packet_identity"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "packet"
                  },
                  "slice_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "packet_identity": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "slice_id",
                  "id",
                  "packet_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "observation"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "lifecycle"
                  },
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  }
                },
                "required": [
                  "kind",
                  "evidence_id",
                  "revision",
                  "blob_sha"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "repo_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  }
                },
                "required": [
                  "kind",
                  "repo_key",
                  "path",
                  "revision",
                  "blob_sha"
                ],
                "additionalProperties": false
              }
            ]
          },
          "establishes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "reference",
          "establishes",
          "limitation"
        ],
        "additionalProperties": false
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "packet"
                  },
                  "slice_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "packet_identity": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "slice_id",
                  "id",
                  "packet_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "observation"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "lifecycle"
                  },
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  }
                },
                "required": [
                  "kind",
                  "evidence_id",
                  "revision",
                  "blob_sha"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "repo_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  }
                },
                "required": [
                  "kind",
                  "repo_key",
                  "path",
                  "revision",
                  "blob_sha"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 60,
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "packet"
                      },
                      "slice_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "packet_identity": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "slice_id",
                      "id",
                      "packet_identity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "observation"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "lifecycle"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      },
                      "blob_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      }
                    },
                    "required": [
                      "kind",
                      "evidence_id",
                      "revision",
                      "blob_sha"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "source"
                      },
                      "repo_key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      },
                      "blob_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      }
                    },
                    "required": [
                      "kind",
                      "repo_key",
                      "path",
                      "revision",
                      "blob_sha"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "recovered": {
                "type": "boolean"
              }
            },
            "required": [
              "reference",
              "reason",
              "recovered"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "complete",
        "gaps"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "classification": {
            "enum": [
              "registered_but_unread",
              "reviewed_with_limitations",
              "observation_required",
              "unverified"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "references": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "packet"
                    },
                    "slice_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "packet_identity": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "slice_id",
                    "id",
                    "packet_identity"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "observation"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "lifecycle"
                    },
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                    },
                    "blob_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                    }
                  },
                  "required": [
                    "kind",
                    "evidence_id",
                    "revision",
                    "blob_sha"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "source"
                    },
                    "repo_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                    },
                    "blob_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo_key",
                    "path",
                    "revision",
                    "blob_sha"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 60,
            "uniqueItems": true
          },
          "next_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "question",
          "classification",
          "basis",
          "references",
          "next_action"
        ],
        "additionalProperties": false
      }
    },
    "maintenance_trigger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "memory_status": {
      "const": "not-promoted"
    },
    "observation_assessment": {
      "description": "Null when no registry observations are used. Otherwise validator recomputes compatibility; separate records cannot support a joint behavioral conclusion.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "expected_scope": {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                  }
                },
                "binding_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "sources",
                "binding_sha256"
              ],
              "additionalProperties": false
            },
            "declared_status": {
              "enum": [
                "compatible",
                "incompatible",
                "conflicting",
                "unknown"
              ]
            },
            "use": {
              "enum": [
                "separate_context",
                "joint_support"
              ]
            }
          },
          "required": [
            "ids",
            "expected_scope",
            "declared_status",
            "use"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "claim",
    "outcome",
    "scope",
    "packets",
    "evidence",
    "delivery",
    "unresolved",
    "maintenance_trigger",
    "memory_status",
    "observation_assessment"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped verification finding v5"
}
