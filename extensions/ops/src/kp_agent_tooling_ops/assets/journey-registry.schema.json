{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/journey-registry.v1.json",
  "title": "OPS operator-owned journey registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "sources", "slices", "questions"],
  "properties": {
    "schema_version": {"const": "ops.journey-registry.v1"},
    "product": {"$ref": "#/$defs/name"},
    "sources": {
      "type": "object", "minProperties": 1, "maxProperties": 12,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/revision"}
    },
    "slices": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/slice"}},
    "questions": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 300},
    "sourceEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "repo_key", "path", "blob_sha", "start_line", "end_line"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "kind": {"const": "source"},
        "repo_key": {"$ref": "#/$defs/name"},
        "path": {"type": "string", "minLength": 1, "maxLength": 300},
        "blob_sha": {"$ref": "#/$defs/revision"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "role": {"enum": ["target", "supporting_evidence"]}
      }
    },
    "observationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "observation_id", "subject", "binding_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "kind": {"const": "observation"},
        "observation_id": {"$ref": "#/$defs/hash"},
        "subject": {"$ref": "#/$defs/text"},
        "binding_sha256": {"$ref": "#/$defs/hash"},
        "role": {"enum": ["target", "supporting_evidence"]}
      }
    },
    "adjacent": {
      "type": "object", "additionalProperties": false,
      "required": ["target_slice", "question", "relation"],
      "properties": {
        "target_slice": {"$ref": "#/$defs/name"},
        "question": {"$ref": "#/$defs/text"},
        "relation": {"$ref": "#/$defs/name"}
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "basis"],
      "properties": {"question": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}}
    },
    "slice": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "evidence", "adjacent", "unresolved"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "title": {"$ref": "#/$defs/text"},
        "feature_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "spec_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20,
                     "items": {"oneOf": [{"$ref": "#/$defs/sourceEvidence"}, {"$ref": "#/$defs/observationEvidence"}]}},
        "adjacent": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/adjacent"}},
        "unresolved": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/unresolved"}}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_id", "evidence_ids"],
      "properties": {
        "slice_id": {"$ref": "#/$defs/name"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 20,
                         "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "requires"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "requires": {"type": "array", "minItems": 1, "maxItems": 32,
                     "items": {"$ref": "#/$defs/requirement"}}
      }
    }
  }
}
